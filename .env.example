# Copy to env.conf (or export) before starting the server.
# Nothing here has a personal default: an unset value fails loudly rather than
# silently addressing someone else's cluster account.

# ── public identity ────────────────────────────────────────────────────────
# Host ChatGPT connects to. Also the OAuth issuer, so it must match the
# certificate and the redirect the connector was registered with.
FEMTOMIND_PUBLIC_HOST=femtomind.example.org
FEMTOMIND_APP_PORT=8010

# ── cluster ────────────────────────────────────────────────────────────────
# The two hops. GATEWAY takes a PIN plus a one-time code, IFARM an account
# password; both are entered in the panel and neither is stored.
FEMTOMIND_GATEWAY_HOST=scilogin.example.org
FEMTOMIND_IFARM_HOST=ifarm.example.org
FEMTOMIND_HPC_HOST=ifarm.example.org
# Fallback cluster account used only when a caller has none on file.
FEMTOMIND_HPC_USER=
# How long an SSH ControlMaster is kept open (the one-time code is needed once
# per session rather than once per action).
FEMTOMIND_CONTROL_PERSIST=8h

# ── physics backend ────────────────────────────────────────────────────────
# The mcpo gateway fronting the fitpack and hpc MCP servers.
FEMTOMIND_MCPO_BASE=http://127.0.0.1:8000
# Repository cloned into each collaborator's workspace, and the shared grids
# their run directories symlink to.
FEMTOMIND_FITPACK_REPO=
FEMTOMIND_SHARED_GRIDS=

# ── auth ───────────────────────────────────────────────────────────────────
# Set to 0 only for local development; the deployed server must require tokens.
FEMTOMIND_REQUIRE_AUTH=1
FEMTOMIND_TOKEN_TTL_S=2592000
# Extra OAuth redirect prefixes beyond chatgpt.com, comma separated.
FEMTOMIND_EXTRA_REDIRECTS=

# ── debugging ──────────────────────────────────────────────────────────────
# Logs request headers for every /mcp call. Leave unset in normal operation.
FEMTOMIND_DEBUG_HEADERS=
