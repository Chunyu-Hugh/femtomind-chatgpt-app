# systemd EnvironmentFile for all FemtoMind units.
# No secrets belong here; see DEPLOYMENT.md. Copy to ~/femtomind/env.conf
# and fill in the fallback username.
#
# (Note: deploy/env.sh is a stale shell variant of this file and is missing
# FEMTOMIND_PUBLIC_HOST and FASTMCP_LOG_LEVEL; env.conf is the one the units read.)
HPC_REMOTE_BASE_TEMPLATE="/w/ceph24/JAM/{username}/fitpack_legacy"
FITPACK_REMOTE_TEMPLATE="/w/ceph24/JAM/{username}/fitpack_legacy"
FITPACK_DB_PATH="/home/ec2-user/femtomind/fitpack-workflow/hpc_tasks.db"
FITPACK_MCP_PATH="/home/ec2-user/femtomind/fitpack-workflow"
FITPACK_LOCAL_DIR="/home/ec2-user/femtomind/fitpack-workflow"
FEMTOMIND_PLOT_ON_HPC=1
FEMTOMIND_HPC_USER=<your-jlab-username>
FEMTOMIND_PUBLIC_HOST=femtomind.duckdns.org
FASTMCP_LOG_LEVEL=DEBUG
