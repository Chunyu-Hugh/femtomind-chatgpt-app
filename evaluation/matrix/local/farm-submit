#!/usr/bin/env bash
# The agent's way to submit its one Slurm job (a script inside its run directory).
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
[ $# -eq 1 ] || { echo "usage: farm-submit <script>" >&2; exit 2; }
printf %s "$1" | base64 -w0 | ssh -S "$(cat "$here/SOCK")" -o BatchMode=yes ifarm-tunnel \
  "/w/ceph24/JAM/chunyu/bench_eval/bin/submit.sh $(cat "$here/RUN")" 2> >(grep -v syscshrc >&2)
